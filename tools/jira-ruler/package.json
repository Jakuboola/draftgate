{
  "name": "jira-ruler",
  "private": true,
  "version": "0.0.0",
  "description": "Atlassian editor-core, built once and kept as a measuring instrument. Not a dependency, not in the plugin tree.",
  "main": "main.cjs",
  "scripts": {
    "build": "vite build",
    "start": "bun ../electron/run.ts .",
    "start:build": "vite build && bun ../electron/run.ts .",
    "try": "vite build && RULER_INTERACTIVE=1 bun ../electron/run.ts .",
    "try:nobuild": "RULER_INTERACTIVE=1 bun ../electron/run.ts .",
    "styles": "bun ../electron/run.ts probe-styles.cjs"
  },
  "dependencies": {
    "@atlaskit/editor-common": "^120.11.0",
    "@atlaskit/editor-core": "^226.3.3",
    "@atlaskit/link-provider": "*",
    "@atlaskit/media-core": "^38.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-intl": "^6.6.8",
    "vite-plugin-node-polyfills": "^0.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.0"
  },
  "overrides": {
    "lodash": "^4.18.0",
    "prismjs": "^1.30.0",
    "path-to-regexp": "^3.3.0"
  }
}
