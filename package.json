{
  "name": "draftgate",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Destination-aware review gate for agent-generated outbound messages",
  "scripts": {
    "test": "bun test",
    "test:update-golden": "UPDATE_GOLDEN=1 bun test",
    "spec:baseline": "bun core/test/spec/writeBaseline.ts",
    "spec:report": "bun core/test/spec/report.ts",
    "history:baseline": "bun test/history/writeBaseline.ts",
    "history:report": "bun test/history/report.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p core && tsc --noEmit -p surface",
    "build:surface": "bun cli/src/buildSurface.ts",
    "build:host": "bun cli/src/reviewHost.ts",
    "build:plugin": "bun run build:surface && bun cli/src/pluginDev.ts",
    "release": "bun cli/src/release.ts",
    "surface:probe": "bun run build:surface && bun surface/harness/probe.ts",
    "cli": "bun cli/src/main.ts",
    "surface:e2e": "bun run build:surface && bun surface/harness/e2e.ts",
    "surface:host": "bun run build:surface && bun surface/harness/host.ts",
    "fonts:lato": "bun run build:surface && bun surface/harness/lato.ts",
    "measure:headings": "bun tools/electron/run.ts tools/jira-ruler/probe-headings.cjs",
    "measure:blocks": "bun tools/electron/run.ts tools/jira-ruler/probe-blocks.cjs",
    "measure:styles": "bun tools/electron/run.ts tools/jira-ruler/probe-styles.cjs",
    "measure:linenos": "bun tools/electron/run.ts tools/jira-ruler/probe-linenos.cjs",
    "measure:dark": "bun tools/electron/run.ts tools/jira-ruler/probe-dark.cjs",
    "measure:renderer": "bun tools/electron/run.ts tools/jira-ruler/probe-renderer.cjs",
    "measure:github": "bun tools/electron/run.ts tools/github-ruler/measure.cjs",
    "tokens:jira": "bun tools/atlassian-tokens/extract.mjs",
    "tokens:linear": "bun tools/linear-tokens/extract.mjs",
    "tokens:slack": "bun tools/slack-tokens/extract.mjs",
    "jira:projects": "bun tools/jira-projects/generate.mjs",
    "github:repos": "bun tools/github-repos/generate.mjs",
    "icon:build": "bun tools/icon/build.ts"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5",
    "@fontsource-variable/roboto-mono": "5",
    "@happy-dom/global-registrator": "^21.0.4",
    "@tiptap/extension-code": "^3.31.0",
    "@tiptap/extension-code-block-lowlight": "^3.31.0",
    "@tiptap/extension-image": "^3.31.0",
    "@tiptap/extension-mention": "^3.31.0",
    "@tiptap/extension-table": "^3.31.0",
    "@tiptap/extension-task-item": "^3.31.0",
    "@tiptap/extension-task-list": "^3.31.0",
    "@tiptap/pm": "^3.31.0",
    "@tiptap/react": "^3.31.0",
    "@tiptap/starter-kit": "^3.31.0",
    "@types/bun": "latest",
    "@types/mdast": "^4.0.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "commonmark-spec": "^0.31.2",
    "happy-dom": "^21.0.4",
    "lato-font": "3",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.39.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark": "^4.0.2",
    "micromark-extension-gfm": "^3.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.0",
    "unicode-emoji-json": "^0.9.0",
    "vite": "^8.2.2"
  },
  "bin": {
    "draftgate": "./cli/src/main.ts"
  }
}
